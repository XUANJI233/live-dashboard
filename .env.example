# Device tokens: format is token:device_id:device_name:platform
DEVICE_TOKEN_1=changeme_token1:my-pc:My PC:windows
DEVICE_TOKEN_2=changeme_token2:my-phone:My Phone:android
DEVICE_TOKEN_3=changeme_token3:my-watch:My Watch:zepp

# HMAC secret for hashing window_title (used for dedup, prevents rainbow table attacks)
# Generate with: openssl rand -hex 32
HASH_SECRET=changeme_generate_a_random_secret

# Optional site customization
DISPLAY_NAME=Monika
SITE_TITLE=Monika Now
SITE_DESC=What is Monika doing right now?
SITE_FAVICON=/favicon.ico

# Edge Function integration. Keep both false for direct-to-origin deployments.
EDGE_MODE=false
REQUIRE_EDGE=false

# MCP control plane for OpenClaw/Hermes.
# Local controllers can use http://127.0.0.1:${MCP_PORT}/api/mcp with a bearer token.
# Set MCP_LOOPBACK_TOKENLESS_ENABLED=true only for trusted single-user local development.
# Remote controllers must set MCP_REMOTE_ENABLED=true and a bearer token.
# Docker host-side local controllers can publish MCP_PORT to 127.0.0.1 by setting
# MCP_HOST=0.0.0.0, MCP_LOCAL_NETWORK_ENABLED=true, and a bearer token.
MCP_PORT=3031
MCP_HOST=127.0.0.1
MCP_LOOPBACK_TOKENLESS_ENABLED=false
MCP_LOCAL_NETWORK_ENABLED=false
MCP_REMOTE_ENABLED=false
MCP_SERVER_TOKEN=
MCP_ADMIN_TOKEN=
